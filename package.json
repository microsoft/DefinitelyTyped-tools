{
  "name": "definitelytyped-tools",
  "private": true,
  "engines": {
    "node": "^24.15.0 || >=26"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint . --report-unused-disable-directives --ext .ts",
    "format": "prettier --write 'packages/**/*.ts'",
    "format:check": "prettier --check 'packages/**/*.ts'",
    "test": "node run-tests.mjs",
    "build": "tsc -b .",
    "retag": "node packages/retag/dist/index.js"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.1.0",
    "jest": "^30.5.2",
    "knip": "^6.40.0",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "tough-cookie@<4.1.3": ">=4.1.3",
      "semver@<5.7.2": ">=5.7.2",
      "semver@>=6.0.0 <6.3.1": ">=6.3.1",
      "@types/node": "$@types/node"
    },
    "updateConfig": {
      "ignoreDependencies": [
        "typescript-*.*"
      ]
    },
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "core-js",
      "core-js-pure",
      "unrs-resolver",
      "yarn"
    ],
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6"
}
