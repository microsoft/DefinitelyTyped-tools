{
  "name": "@definitelytyped/dts-critic",
  "version": "0.1.37",
  "author": "Nathan Shively-Sanders",
  "description": "Checks a new .d.ts against the Javascript source and tells you what problems it has",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@definitelytyped/header-parser": "workspace:*",
    "typescript": "^6.0.3",
    "yargs": "^18.2.0"
  },
  "peerDependencies": {
    "typescript": "<7"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b .",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../jest.config.js packages/dts-critic"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/DefinitelyTyped-tools.git",
    "directory": "packages/dts-critic"
  },
  "keywords": [
    "definitely",
    "typed",
    "refresh",
    "npm",
    "tag"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/microsoft/DefinitelyTyped-tools/issues"
  },
  "homepage": "https://github.com/microsoft/DefinitelyTyped-tools/tree/main/packages/dts-critic#readme",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  }
}
